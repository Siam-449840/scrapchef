# PUTER_AUTH_TOKEN: Optional developer fallback token for local dev/testing.
# In production, each user connects their personal Puter account (User-Pays Model).
# Get a token from https://puter.com/dashboard
PUTER_AUTH_TOKEN="YOUR_PUTER_AUTH_TOKEN"

# PUTER_MODEL: The Puter AI model for recipe generation.
# Default official Puter model: gpt-5-nano
# Supported alternatives: gemini-3.1-flash-lite, gemma-4-26b-a4b-it
PUTER_MODEL="gpt-5-nano"
