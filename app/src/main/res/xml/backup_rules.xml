<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude Room database and DataStore from cloud backups to prevent
         data leakage of user dietary preferences (health-adjacent data). -->
    <exclude domain="database" path="scrapchef_database"/>
    <exclude domain="file" path="datastore/settings.preferences_pb"/>
</full-backup-content>
